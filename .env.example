# Copy to .env (git-ignored) and `set -a; source .env; set +a` before running.

# Raw sources: refcoco*/data/*.parquet, grefcoco/{grefs(unc).json,instances.json}, coco2017/data/*.parquet, coco_train2014/
JEV_DATA=~/experiments/jevbox_20261117/data
# prepared records (train.jsonl, eval_*.jsonl)
JEV_PREP=~/experiments/jevbox_20261117/v2/data/prep
# where this pipeline writes
GLANCE_OUT=out
# a FILE holding the DeepSeek key (chmod 600, outside the repo) — never put the key itself here
DEEPSEEK_API_KEY_FILE=~/experiments/jevbox_20261117/.secrets/deepseek_key
# minimal pairs (make twins): COCO instances json for candidate twin images, and the held-out image ids to exclude.
# The default COCO_ANN covers the 19,994 RefCOCO images; v1.4 used the full COCO instances_train2014.json.
COCO_ANN=~/experiments/jevbox_20261117/data/grefcoco/instances.json
# EVAL_IDS=<json list, or dict of lists, of every benchmark image id>
